{
  "campaign_id": "smoke-test-001",
  "paths": {
    "repo_root": "{repo_root}",
    "lake_name": "events.jsonl"
  },
  "runtime": {
    "python_exe": "{sys_executable}",
    "threads": 2,
    "timeout_sec": 60,
    "max_empty_rounds": 1
  },
  "dihiggs": {
    "phys_exec": "{phys_scan_exec}",
    "hb_dataset_env": "HB_DATASET",
    "hs_dataset_env": "HS_DATASET"
  },
  "search": {
    "tb_values": [1000],
    "lam1": {
      "min": -20.0,
      "max": 20.0,
      "n_bins": 10
    },
    "mphi": {
      "min": 0.0,
      "max": 1000.0,
      "n_bins": 5
    }
  },
  "limits": {
    "max_new_run_dirs_per_round": 2,
    "max_new_run_dirs_per_arm_call": 2
  },
  "metrics": {
    "floors": {
      "yield_norm": 0.01,
      "coverage_norm": 0.0,
      "diversity_norm": 0.0
    },
    "weights": {
      "yield": 0.4,
      "coverage": 0.3,
      "diversity": 0.3
    },
    "multi_axis": {
      "enabled": true,
      "collapse_axes": ["tb", "lam1_bin"],
      "coverage_axes": [
        {
          "name": "tb",
          "kind": "categorical",
          "domain": [1000],
          "weight": 0.5
        },
        {
          "name": "lam1_bin",
          "kind": "discrete",
          "domain_size": 10,
          "weight": 0.5
        }
      ],
      "diversity_axes": [
        {
          "name": "tb",
          "weight": 0.5
        },
        {
          "name": "lam1_bin",
          "weight": 0.5
        }
      ],
      "diversity_pairs": []
    }
  },
  "adaptation": {
    "ucb_c": 1.414,
    "warm_start_each_arm": false
  },
  "arms": [
    {
      "id": "adaptive-smoke",
      "explorer": "adaptive",
      "timeout_sec": 60,
      "cmd": [
        "{python}",
        "{repo_root}/dihiggs/app/adaptive_explorer.py",
        "--checkpoint-root",
        "{checkpoint_root}/adaptive-smoke",
        "--tb-values",
        "{tb_values}",
        "--lam1-range",
        "{lam1_min}",
        "{lam1_max}",
        "--n-bins",
        "{lam1_n_bins}",
        "--n-proposals",
        "1",
        "--iter",
        "{iter}"
      ],
      "env": {
        "HB_DATASET": "{hb_dataset}",
        "HS_DATASET": "{hs_dataset}",
        "OMP_NUM_THREADS": "{threads}"
      }
    }
  ]
}
