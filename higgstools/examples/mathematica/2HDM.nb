Cell[BoxData[
 RowBox[{
  RowBox[{"LoadDataSet", "[", "path_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "ds", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ds", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"path", ",", "\"\<Dataset\>\"", ",", 
        RowBox[{"\"\<HeaderLines\>\"", "->", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"ds", "[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"#", ",", 
           RowBox[{"\"\<beta\>\"", "->", 
            RowBox[{"ArcTan", "[", "#tbeta", "]"}]}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"ds", "[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"#", ",", 
           RowBox[{"\"\<cba\>\"", "->", 
            RowBox[{"Cos", "[", 
             RowBox[{"#beta", "-", "#alpha"}], "]"}]}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "ds"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.868440089527659*^9, 3.8684402086397457`*^9}, {
  3.868440241035132*^9, 3.8684402636212254`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"4c397438-6d90-4a4a-aec3-995f9416c6bf"]
