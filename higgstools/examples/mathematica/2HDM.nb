Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getHBexclusion", "[", "hbres_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "hblim", ",", "IDs", ",", "obsRatios", ",", "obsRatioA", ",", 
       "obsRatioH", ",", "obsRatioHp"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hblim", "=", 
       RowBox[{"hbres", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"IDs", "=", 
       RowBox[{"particleID", "/.", "hblim"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"obsRatios", "=", 
       RowBox[{"obsRatio", "/.", "hblim"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"obsRatioA", "=", 
       RowBox[{"obsRatios", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"IDs", ",", "\"\<A\>\""}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"obsRatioH", "=", 
       RowBox[{"obsRatios", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"IDs", ",", "\"\<H\>\""}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"obsRatioHp", "=", 
       RowBox[{"obsRatios", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"IDs", ",", "\"\<Hp\>\""}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"obsRatioA", ">", "1"}], "||", 
         RowBox[{"obsRatioH", ">", "1"}], "||", 
         RowBox[{"obsRatioHp", ">", "1"}]}], ",", "0", ",", "1"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotRes", "[", 
   RowBox[{"data_", ",", "hbres_", ",", "hsres_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{"ListContourPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"data", "[", 
             RowBox[{"All", ",", "\"\<cba\>\""}], "]"}]}], ",", 
           RowBox[{"Normal", "@", 
            RowBox[{"data", "[", 
             RowBox[{"All", ",", "\"\<tbeta\>\""}], "]"}]}], ",", 
           RowBox[{"getHBexclusion", "/@", "hbres"}]}], "}"}], "]"}], ",", 
        RowBox[{"Contours", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], ",", 
        RowBox[{"ContourShading", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", "LightGray"}], "}"}]}], ",", 
        RowBox[{"ContourStyle", "\[Rule]", "None"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"data", "[", 
             RowBox[{"All", ",", "\"\<cba\>\""}], "]"}]}], ",", 
           RowBox[{"Normal", "@", 
            RowBox[{"data", "[", 
             RowBox[{"All", ",", "\"\<tbeta\>\""}], "]"}]}], ",", "hsres"}], 
          "}"}], "]"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<cos(b-a)\>\"", ",", "\"\<tanb\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "\[Rule]", 
         RowBox[{"BarLegend", "[", 
          RowBox[{"Automatic", ",", 
           RowBox[{
           "LegendLabel", "\[Rule]", 
            "\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\[Chi]\), \
\(2\)]\)\>\""}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{"ListContourPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"data", "[", 
             RowBox[{"All", ",", "\"\<cba\>\""}], "]"}]}], ",", 
           RowBox[{"Normal", "@", 
            RowBox[{"data", "[", 
             RowBox[{"All", ",", "\"\<tbeta\>\""}], "]"}]}], ",", "hsres"}], 
          "}"}], "]"}], ",", 
        RowBox[{"Contours", "->", 
         RowBox[{"{", 
          RowBox[{"2.3", ",", "5.99"}], "}"}]}], ",", 
        RowBox[{"ContourShading", "\[Rule]", "None"}], ",", 
        RowBox[{"InterpolationOrder", "\[Rule]", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{"p2", ",", "p1", ",", "p3"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.875099059754937*^9, 3.875099075878961*^9}, {
