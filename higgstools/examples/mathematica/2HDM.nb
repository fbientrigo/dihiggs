  RowBox[{
   RowBox[{"CalcEffCtype1", "[", 
    RowBox[{"alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"effC", " ", "for", " ", "h"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"uuh", "=", 
        RowBox[{
         RowBox[{"Cos", "[", "alpha", "]"}], "/", 
         RowBox[{"Sin", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ddh", "=", 
        RowBox[{
         RowBox[{"Cos", "[", "alpha", "]"}], "/", 
         RowBox[{"Sin", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"vvh", "=", 
        RowBox[{"Sin", "[", 
         RowBox[{"beta", "-", "alpha"}], "]"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{"effC", " ", "for", " ", "H"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"uuH", "=", 
        RowBox[{
         RowBox[{"Sin", "[", "alpha", "]"}], "/", 
         RowBox[{"Sin", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ddH", "=", 
        RowBox[{
         RowBox[{"Sin", "[", "alpha", "]"}], "/", 
         RowBox[{"Sin", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"vvH", "=", 
        RowBox[{"Cos", "[", 
         RowBox[{"beta", "-", "alpha"}], "]"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{"effC", " ", "for", " ", "A"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"uuA", "=", 
        RowBox[{"1", "/", 
         RowBox[{"Tan", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ddA", "=", 
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{"Tan", "[", "beta", "]"}]}]}]}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"uuh", ",", "ddh", ",", "vvh"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"uuH", ",", "ddH", ",", "vvH"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"uuA", ",", "ddA"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CalcEffCtype2", "[", 
    RowBox[{"alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"effC", " ", "for", " ", "h"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"uuh", "=", 
        RowBox[{
         RowBox[{"Cos", "[", "alpha", "]"}], "/", 
         RowBox[{"Sin", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ddh", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sin", "[", "alpha", "]"}]}], "/", 
         RowBox[{"Cos", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"vvh", "=", 
        RowBox[{"Sin", "[", 
         RowBox[{"beta", "-", "alpha"}], "]"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{"effC", " ", "for", " ", "H"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"uuH", "=", 
        RowBox[{
         RowBox[{"Sin", "[", "alpha", "]"}], "/", 
         RowBox[{"Sin", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ddH", "=", 
        RowBox[{
         RowBox[{"Cos", "[", "alpha", "]"}], "/", 
         RowBox[{"Cos", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"vvH", "=", 
        RowBox[{"Cos", "[", 
         RowBox[{"beta", "-", "alpha"}], "]"}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{"effC", " ", "for", " ", "A"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"uuA", "=", 
        RowBox[{"1", "/", 
         RowBox[{"Tan", "[", "beta", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ddA", "=", 
        RowBox[{"Tan", "[", "beta", "]"}]}]}], "\[IndentingNewLine]", "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"uuh", ",", "ddh", ",", "vvh"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"uuH", ",", "ddH", ",", "vvH"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"uuA", ",", "ddA"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CalcEffCtype3", "[", 
    RowBox[{"alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{"CalcEffCtype1", "[", 
    RowBox[{"alpha", ",", "beta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CalcEffCtype4", "[", 
    RowBox[{"alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{"CalcEffCtype2", "[", 
    RowBox[{"alpha", ",", "beta"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CalcEffC", "[", 
    RowBox[{"alpha_", ",", "beta_", ",", "type_"}], "]"}], ":=", 
   RowBox[{"Switch", "[", "\[IndentingNewLine]", 
    RowBox[{"type", ",", "\[IndentingNewLine]", "1", ",", 
     RowBox[{"CalcEffCtype1", "[", 
      RowBox[{"alpha", ",", "beta"}], "]"}], ",", "\[IndentingNewLine]", "2", 
     ",", 
     RowBox[{"CalcEffCtype2", "[", 
      RowBox[{"alpha", ",", "beta"}], "]"}], ",", "\[IndentingNewLine]", "3", 
     ",", 
     RowBox[{"CalcEffCtype3", "[", 
      RowBox[{"alpha", ",", "beta"}], "]"}], ",", "\[IndentingNewLine]", "4", 
     ",", 
     RowBox[{"CalcEffCtype4", "[", 
      RowBox[{"alpha", ",", "beta"}], "]"}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RunHiggsTools", "[", 
    RowBox[{"point_", ",", "type_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"effC", "=", 
        RowBox[{"CalcEffC", "[", 
         RowBox[{
          RowBox[{"point", "[", "\"\<alpha\>\"", "]"}], ",", 
          RowBox[{"point", "[", "\"\<beta\>\"", "]"}], ",", "type"}], "]"}]}],
        ",", "\[IndentingNewLine]", "hbres", ",", "\[IndentingNewLine]", 
       "chisq"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SethProperties", "[", 
       RowBox[{"point", ",", 
        RowBox[{"effC", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"SetHProperties", "[", 
       RowBox[{"point", ",", 
        RowBox[{"effC", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"SetAProperties", "[", 
       RowBox[{"point", ",", 
        RowBox[{"effC", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"SetHpProperties", "[", "point", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hbres", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HBApplyBounds", "[", "]"}], ",", 
         RowBox[{"HBGetSelectedBounds", "[", "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"chisq", "=", 
       RowBox[{"HSGetChisq", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"hbres", ",", "chisq"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CalcDeltaChisq", "[", "list_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"chisqmin", ",", "out"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"chisqmin", "=", 
       RowBox[{"Min", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"out", "=", "list"}], ";", "\[IndentingNewLine]", 
      RowBox[{"out", "-=", "chisqmin"}], ";", "\[IndentingNewLine]", 
      "out"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"processData", "[", 
    RowBox[{"data_", ",", "type_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"HBres", ",", "HSres", ",", "n"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"HBres", ",", "HSres"}], "}"}], "=", 
         RowBox[{"Transpose", "@", 
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"n", "=", 
                RowBox[{"#", "[", "\"\<\>\"", "]"}]}], ";", 
               RowBox[{"RunHiggsTools", "[", 
                RowBox[{"#", ",", "type"}], "]"}]}], ")"}], "&"}], "/@", 
            "data"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"ProgressIndicator", "[", 
         RowBox[{
          RowBox[{"Dynamic", "[", "n", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"HSres", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "<", "6.001"}], ",", "#", ",", "6.001"}], "]"}], 
         "&"}], "/@", 
        RowBox[{"CalcDeltaChisq", "[", "HSres", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"HBres", ",", "HSres"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
