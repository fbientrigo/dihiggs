{
    "name": "DiHiggs C++ & Python Env",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "twxs.cmake",
                "mhutchie.git-graph"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3"
            }
        }
    },
    // CAMBIO IMPORTANTE: Ahora usamos el usuario nativo de la imagen
    "remoteUser": "vscode",
    "containerEnv": {
        "HB_DATASET": "/workspaces/dihiggs/datasets/HBDataset",
        "HS_DATASET": "/workspaces/dihiggs/datasets/HSDataset"
    },
    "postCreateCommand": "bash .devcontainer/post-install.sh"
}